{
  "name": "careshift",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm --workspace @careshift/web run dev",
    "build:web": "npm --workspace @careshift/web run build",
    "lint:web": "npm --workspace @careshift/web run lint",
    "dev:mobile": "npm --workspace @careshift/mobile run start",
    "android": "npm --workspace @careshift/mobile run android",
    "ios": "npm --workspace @careshift/mobile run ios",
    "typecheck:mobile": "npm --workspace @careshift/mobile run typecheck",
    "dev:api": "npm --workspace @careshift/api run dev",
    "typecheck:api": "npm --workspace @careshift/api run typecheck",
    "deploy:api": "npm --workspace @careshift/api run deploy",
    "db:generate": "npm --workspace @careshift/db run generate",
    "db:migrate:local": "npm --workspace @careshift/db run migrate:local",
    "db:migrate:remote": "npm --workspace @careshift/db run migrate:remote",
    "convex:dev": "convex dev",
    "convex:once": "convex dev --once"
  },
  "devDependencies": {
    "convex": "^1.50.0"
  }
}
