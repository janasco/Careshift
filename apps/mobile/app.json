{
  "expo": {
    "name": "CareShift Caregiver",
    "slug": "careshift",
    "version": "0.1.0",
    "scheme": "careshift",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CareShift to record your location when you clock in and out."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexsinc.careshift"
    },
    "android": {
      "package": "com.apexsinc.careshift",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
